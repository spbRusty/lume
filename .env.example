# Copy to `.env` and adjust. Every value here has a built-in default,
# so an empty `.env` is a valid configuration.

# --- Model runtime -------------------------------------------------------
# Ollama endpoint.
LUME_OLLAMA_URL=http://127.0.0.1:11434

# --- Model tiers ---------------------------------------------------------
# "Large" tier: planning, decomposition, decisions. Slow but capable.
LUME_LARGE_MODEL=qwen2.5:7b
# "Small" tier: fast execution of well-specified steps.
LUME_SMALL_MODEL=qwen2.5-coder:1.5b

# --- Agent budget --------------------------------------------------------
# Hard cap on ReAct iterations before the run is abandoned.
LUME_MAX_ITERATIONS=24
# Context window assumed for compaction decisions. Must match the served model.
LUME_CONTEXT_WINDOW=8192
# Directory the file and shell tools are confined to. Defaults to the current
# working directory when unset.
# LUME_WORKSPACE_ROOT=/home/vlad/projects

# --- MCP servers ---------------------------------------------------------
# MCP servers are configured in the TOML config file, not here, because each
# one needs a command line or a URL. See `mcp.example.toml`.
#
# [[mcp_servers]]
# name = "filesystem"
# transport = "stdio"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/home/vlad/projects"]
#
# [[mcp_servers]]
# name = "fetch"
# transport = "http"
# url = "http://127.0.0.1:8931/mcp"